.env
.env.*
!.env.example
.streamlit/secrets.toml

# Local databases
*.db
*.sqlite
*.sqlite3

# Temporary files
~$*
*.tmp
*.temp

# Editor and operating system files
.vscode/
.DS_Store
Thumbs.db